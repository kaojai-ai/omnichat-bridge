{
  "manifest_version": 3,
  "name": "Omnichat Bridge",
  "version": "0.5.17",
  "description": "Syncs supported provider chat messages in realtime and forwards them to your configured server.",
  "permissions": ["alarms", "scripting", "storage"],
  "host_permissions": ["https://seller.shopee.co.th/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://seller.shopee.co.th/*"],
      "js": ["lib/shopee-url.js", "lib/provider-adapters.js", "lib/shopee-adapter.js", "shopee-realtime.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://seller.shopee.co.th/*"],
      "js": ["lib/shopee-url.js", "lib/shopee.js", "lib/provider-adapters.js", "lib/shopee-adapter.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_title": "Omnichat Bridge", "default_popup": "popup.html" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  }
}
